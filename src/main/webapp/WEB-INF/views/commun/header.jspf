<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="moi" value="${sessionScope.utilisateur}"/>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>UNAF – Inscriptions</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="${ctx}/assets/style.css" rel="stylesheet">
</head>
<body class="bg-light">
<c:if test="${not empty moi}">
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container">
        <a class="navbar-brand fw-semibold" href="${ctx}/"><i class="bi bi-mortarboard-fill"></i> UNAF Inscriptions</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav me-auto">
                <c:choose>
                    <c:when test="${moi.role == 'ADMIN'}">
                        <li class="nav-item"><a class="nav-link" href="${ctx}/admin/tableau-de-bord">Tableau de bord</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Structure</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="${ctx}/admin/facultes">Facultés</a></li>
                                <li><a class="dropdown-item" href="${ctx}/admin/programmes">Programmes</a></li>
                                <li><a class="dropdown-item" href="${ctx}/admin/cours">Cours</a></li>
                                <li><a class="dropdown-item" href="${ctx}/admin/sessions">Sessions</a></li>
                                <li><a class="dropdown-item" href="${ctx}/admin/salles">Salles</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/admin/professeurs">Professeurs</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/admin/dossiers">Dossiers &amp; paiements</a></li>
                    </c:when>
                    <c:when test="${moi.role == 'PROFESSEUR'}">
                        <li class="nav-item"><a class="nav-link" href="${ctx}/professeur/cours">Mes cours</a></li>
                    </c:when>
                    <c:otherwise>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/etudiant/accueil">Accueil</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/etudiant/dossier">Mon dossier</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/etudiant/cours">Choix des cours</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/etudiant/emploi-du-temps">Emploi du temps</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/etudiant/notes">Notes</a></li>
                    </c:otherwise>
                </c:choose>
            </ul>
            <span class="navbar-text text-white me-3"><i class="bi bi-person-circle"></i> <c:out value="${moi.nomComplet}"/>
                <span class="badge bg-light text-primary ms-1">${moi.role}</span></span>
            <a class="btn btn-outline-light btn-sm" href="${ctx}/logout">Déconnexion</a>
        </div>
    </div>
</nav>
</c:if>
<main class="container pb-5">
<c:if test="${not empty sessionScope.flashMessage}">
    <div class="alert alert-${sessionScope.flashType} alert-dismissible fade show">
        <c:out value="${sessionScope.flashMessage}"/>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <c:remove var="flashMessage" scope="session"/>
    <c:remove var="flashType" scope="session"/>
</c:if>
