<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="fr_FR"/>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="moi" value="${sessionScope.utilisateur}"/>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty titre ? 'Accueil' : titre}"/> · UNAF</title>
    <link rel="icon" href="${ctx}/assets/img/favicon.svg" type="image/svg+xml">
    <link href="${ctx}/assets/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link href="${ctx}/assets/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
    <link href="${ctx}/assets/vendor/fonts/fonts.css" rel="stylesheet">
    <link href="${ctx}/assets/css/unaf.css" rel="stylesheet">
</head>
<body>
<c:choose>
<c:when test="${not empty moi}">
<aside class="app-sidebar" aria-label="Navigation principale">
    <a class="app-brand" href="${ctx}/">
        <span class="app-brand-logo"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i></span>
        <span><span class="app-brand-name d-block">UNAF</span><span class="app-brand-sub">Université Anténor Firmin</span></span>
    </a>
    <nav class="app-nav">
        <c:choose>
            <c:when test="${moi.role == 'ADMIN'}">
                <div class="app-nav-title">Pilotage</div>
                <a href="${ctx}/admin/tableau-de-bord" class="${menu == 'dashboard' ? 'active' : ''}"><i class="bi bi-grid-1x2"></i> Tableau de bord</a>
                <div class="app-nav-title">Scolarité</div>
                <a href="${ctx}/admin/dossiers" class="${menu == 'dossiers' ? 'active' : ''}"><i class="bi bi-folder-check"></i> Admissions
                    <c:if test="${nbDossiersAttente > 0}"><span class="nav-badge">${nbDossiersAttente}</span></c:if></a>
                <a href="${ctx}/admin/etudiants" class="${menu == 'etudiants' ? 'active' : ''}"><i class="bi bi-people"></i> Étudiants</a>
                <a href="${ctx}/admin/professeurs" class="${menu == 'professeurs' ? 'active' : ''}"><i class="bi bi-person-badge"></i> Corps professoral</a>
                <div class="app-nav-title">Offre de formation</div>
                <a href="${ctx}/admin/facultes" class="${menu == 'facultes' ? 'active' : ''}"><i class="bi bi-bank"></i> Facultés</a>
                <a href="${ctx}/admin/programmes" class="${menu == 'programmes' ? 'active' : ''}"><i class="bi bi-diagram-3"></i> Programmes</a>
                <a href="${ctx}/admin/cours" class="${menu == 'cours' ? 'active' : ''}"><i class="bi bi-journal-bookmark"></i> Cours</a>
                <div class="app-nav-title">Organisation</div>
                <a href="${ctx}/admin/sessions" class="${menu == 'sessions' ? 'active' : ''}"><i class="bi bi-calendar3"></i> Sessions</a>
                <a href="${ctx}/admin/salles" class="${menu == 'salles' ? 'active' : ''}"><i class="bi bi-door-open"></i> Salles</a>
            </c:when>
            <c:when test="${moi.role == 'PROFESSEUR'}">
                <div class="app-nav-title">Enseignement</div>
                <a href="${ctx}/professeur/cours" class="${menu == 'prof-cours' ? 'active' : ''}"><i class="bi bi-journal-bookmark"></i> Mes cours</a>
            </c:when>
            <c:otherwise>
                <div class="app-nav-title">Mon espace</div>
                <a href="${ctx}/etudiant/accueil" class="${menu == 'etu-accueil' ? 'active' : ''}"><i class="bi bi-grid-1x2"></i> Tableau de bord</a>
                <a href="${ctx}/etudiant/dossier" class="${menu == 'etu-dossier' ? 'active' : ''}"><i class="bi bi-folder2-open"></i> Dossier d'admission</a>
                <div class="app-nav-title">Études</div>
                <a href="${ctx}/etudiant/cours" class="${menu == 'etu-cours' ? 'active' : ''}"><i class="bi bi-check2-square"></i> Choix des cours</a>
                <a href="${ctx}/etudiant/emploi-du-temps" class="${menu == 'etu-edt' ? 'active' : ''}"><i class="bi bi-calendar-week"></i> Emploi du temps</a>
                <a href="${ctx}/etudiant/notes" class="${menu == 'etu-notes' ? 'active' : ''}"><i class="bi bi-award"></i> Notes &amp; relevé</a>
            </c:otherwise>
        </c:choose>
    </nav>
    <div class="app-sidebar-footer">© Université Anténor Firmin</div>
</aside>

<div class="app-main">
    <header class="app-topbar">
        <button class="btn btn-ghost btn-icon d-lg-none" type="button" data-toggle-sidebar aria-label="Ouvrir le menu"><i class="bi bi-list fs-4"></i></button>
        <div class="me-auto">
            <h1 class="page-title"><c:out value="${titre}"/></h1>
            <c:if test="${not empty sousTitre}"><div class="small text-muted d-none d-md-block"><c:out value="${sousTitre}"/></div></c:if>
        </div>
        <div class="dropdown">
            <a class="app-user dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="avatar"><c:out value="${moi.prenom.substring(0,1)}${moi.nom.substring(0,1)}"/></span>
                <span class="d-none d-sm-block lh-sm">
                    <span class="fw-semibold d-block"><c:out value="${moi.nomComplet}"/></span>
                    <span class="small text-muted">${moi.role == 'ADMIN' ? 'Administration' : moi.role == 'PROFESSEUR' ? 'Professeur' : 'Étudiant'}</span>
                </span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><span class="dropdown-item-text small text-muted"><c:out value="${moi.email}"/></span></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="${ctx}/logout"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
            </ul>
        </div>
    </header>
    <main class="app-content" id="contenu">
    <c:if test="${not empty sessionScope.flashMessage}">
        <div class="alert alert-${sessionScope.flashType} alert-dismissible fade show" role="status" ${sessionScope.flashType == 'success' ? 'data-autoclose' : ''}>
            <i class="bi ${sessionScope.flashType == 'success' ? 'bi-check-circle-fill' : sessionScope.flashType == 'danger' ? 'bi-exclamation-octagon-fill' : 'bi-info-circle-fill'}" aria-hidden="true"></i>
            <div><c:out value="${sessionScope.flashMessage}"/></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
        <c:remove var="flashMessage" scope="session"/>
        <c:remove var="flashType" scope="session"/>
    </c:if>
</c:when>
<c:otherwise>
<div class="app-public">
</c:otherwise>
</c:choose>
